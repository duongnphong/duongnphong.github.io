@InProceedings{10.1007/978-3-031-96126-7_19,
author="Hung, Nguyen Chi
and Phong, Duong Nam
and Fukuzawa, Masayuki
and Le Huy, Vu",
editor="Long, Banh Tien
and Nang, Ho Xuan
and Huy, Pham Thanh
and Kim, Yun-Hae
and Ishizaki, Kozo
and Hyungsun, Kim
and Nguyen, Duc-Toan
and Truong, Vu Van
and Hong Minh, Nguyen Thi
and Duc An, Pham",
title="Integration of Cobot Technology for Cold Plasma Wound Treatment in the Medical Industry",
booktitle="Proceedings of the 4th Annual International Conference on Material, Machines, and Methods for Sustainable Development (MMMS2024)",
year="2025",
publisher="Springer Nature Switzerland",
address="Cham",
pages="143--149",
abstract="The application of collaborative robots (cobots) in the medical industry has been limited due to the nature of human service professions, which require specialized care and professional skills. This article presents a method for using cobots to support the treatment of open wounds using cold plasma, offering a sterilization alternative to conventional antiseptic solutions and bandages. The proposed method involves precise control of the cold plasma tip, maintaining a very low moving speed (approximately 0.5 mm/s) about 5 mm away from the wound surface. Although this operation demands significant time, patience, and technique, the integration of cobot technology presents a promising solution to minimize labor-intensive and expensive repetitive tasks in the medical industry. Specifically, this article discusses the integration of the Cobot Dobot Nova 2 and 3D camera to control the movement of the cold plasma nozzle. The research team has developed a novel control program and interface, leading to a flexible automation solution for medical operations, which has been showcased at domestic exhibitions and is poised for commercialization.",
isbn="978-3-031-96126-7"
}

@InProceedings{10.1007/978-981-95-3358-9_11,
author="Duong, Nam Phong
and Sonoi, Takumi
and Sowa, Yoshihiro
and Fukuzawa, Masayuki",
editor="Thai-Nghe, Nguyen
and Do, Thanh-Nghi
and Benferhat, Salem",
title="Retrospective Contribution Analysis of Intrinsic 3D Breast Features for Esthetic Outcome Evaluation of Breast Reconstruction Surgery",
booktitle="Intelligent Systems and Data Science",
year="2026",
publisher="Springer Nature Singapore",
address="Singapore",
pages="146--156",
abstract="In plastic surgery, an objective technique for evaluating the esthetic outcome of reconstructed breasts from breast images is required, because current evaluation relies on visual assessment by plastic surgeons, which is subject to inter-rater bias and variability. Conventional two-dimensional (2D) breast images are not always suitable for examining the esthetic contribution of intrinsic breast features, as they only provide partial appearances of the breast. While, specially-acquired three-dimensional (3D) images reflect those intrinsic features more comprehensively, its application has been hindered by the complexity of 3D geometry and the extensive implementation efforts required for a large number of cases. In this study, we proposed a novel technique to examine the contribution of intrinsic breast features to specific esthetic viewpoint, even with a limited number of cases, by pre-extracting relevant 3D geometric and color features. This approach enabled the analysis of the correlation between all combinations of 3D features and esthetic scores rated by plastic surgeons. Results from 174 clinical cases revealed that 3D geometric and color features exhibited distinct correlation patterns across different viewpoints, suggesting viewpoint-specific esthetic contributions. For each viewpoint, the top 10 correlated features were identified and used as predictors for multiple linear regression (MLR) modeling. The total esthetic score, aggregated from all the viewpoint-specific MLR models trained on high inter-rater agreement cases, demonstrated a strong correlation {\$}{\$}r{\$}{\$}r = 0.89 with the rater average score. These findings support the effectiveness of the proposed technique and its potential for appearance-based esthetic grading using conventional 2D breast images.",
isbn="978-981-95-3358-9"
}

@article{Sonoi_Duong_Sowa_Fukuzawa_2025, 
title={A clinically-oriented 2D image-analysis system for appearance-based aesthetic outcome evaluation of breast reconstruction surgery}, 
volume={17}, 
url={https://ctujs.ctu.edu.vn/index.php/ctujs/article/view/1857}, 
DOI={10.22144/ctujoisd.2025.051}, 
abstractNote={&lt;p&gt;Aesthetic outcome of reconstructed breasts is currently rated subjectively by plastic surgeons, which introduces inter-rater bias and variability; thus, an image-based objective technique is desired. Developing such a technique, however, has been challenging due to the limited availability of reconstructed breast images under standardized conditions, and the complexity of assessing multiple aesthetic viewpoints. In this study, we propose a clinically-oriented two-dimensional (2D) image-analysis system where small fingerprint pairs representing the left and right breasts are extracted from conventional 2D chest images obtained in clinical settings and used as training data for a simple convolutional neural network (CNN), aiming for high effectiveness even with a limited number of cases. We extracted 16 type variations of fingerprints from 170 cases, and evaluated their influence on CNN performance. The optimal fingerprint types varied depending on the aesthetic viewpoint. The overall aesthetic score, calculated by aggregating the best-performing model scores across all viewpoints, showed a strong correlation (r &amp;gt; 0.9) with the average rater scores. Although 2D images capture only partial breast appearances and may not fully represent intrinsic three-dimensional (3D) features, the experimental results strongly support the potential of the proposed system for developing appearance-based models for aesthetic evaluation in clinical settings.&lt;/p&gt;}, 
number={Special issue: ISDS}, 
journal={CTU Journal of Innovation and Sustainable Development}, 
author={Sonoi, Takumi and Duong, Nam Phong and Sowa, Yoshihiro and Fukuzawa, Masayuki}, 
year={2025}, 
month={Oct.}, 
pages={37-46} }

